---
interface Props {
  yearsInBusiness?: number;
  tagline?: string;
  mainTitle?: string;
  features?: {
    icon: string;
    title: string;
    description: string;
  }[];
}

const {
  yearsInBusiness = 10,
  tagline = `CONFIANZA POR MÁS DE ${yearsInBusiness} AÑOS`,
  mainTitle = "ATM RENT OFRECE ARRIENDO DE EQUIPOS DE CONSTRUCCIÓN, VENTA DE REPUESTOS Y SERVICIO TÉCNICO",
  features = [
    {
      icon: "rental",
      title: "Arriendo de Equipos",
      description: "Amplia flota de maquinaria y equipos de construcción disponibles para arriendo"
    },
    {
      icon: "parts",
      title: "Venta de Repuestos",
      description: "Repuestos originales y de alta calidad para mantener tus equipos funcionando"
    },
    {
      icon: "service",
      title: "Servicio Técnico",
      description: "Mantenimiento preventivo y correctivo con técnicos certificados"
    }
  ]
} = Astro.props;

const icons = {
  rental: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
  parts: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  service: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" /></svg>`
};
---

<section class="py-16 md:py-24 bg-neutral-50 dark:bg-neutral-900">
  <div class="max-w-[85rem] mx-auto px-4 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-orange-500 text-sm font-semibold tracking-wider italic">
        {tagline}
      </span>
      <h2 class="mt-4 text-2xl md:text-4xl lg:text-5xl font-bold text-[#0a1628] dark:text-white leading-tight max-w-4xl mx-auto">
        {mainTitle}
      </h2>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      {features.map((feature) => (
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#0a1628] text-white mb-6 group-hover:bg-orange-500 transition-colors duration-300">
            <Fragment set:html={icons[feature.icon as keyof typeof icons]} />
          </div>
          <h3 class="text-lg font-bold text-[#0a1628] dark:text-white mb-2">
            {feature.title}
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
