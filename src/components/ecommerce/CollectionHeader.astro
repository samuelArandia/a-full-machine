---
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: {
    name: string;
    url: string;
  }[];
  productCount?: number;
  backgroundImage?: string;
}

const {
  title,
  description,
  breadcrumbs = [
    { name: "Inicio", url: "/es" },
    { name: "Colecciones", url: "/es/collections" }
  ],
  productCount,
  backgroundImage
} = Astro.props;
---

<section class="relative bg-[#0a1628] py-12 md:py-20 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  {backgroundImage && (
    <div class="absolute inset-0">
      <img src={backgroundImage} alt="" class="w-full h-full object-cover opacity-20" />
    </div>
  )}

  <div class="relative max-w-[85rem] mx-auto px-4 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-sm">
        {breadcrumbs.map((crumb, index) => (
          <>
            <li>
              <a href={crumb.url} class="text-neutral-400 hover:text-white transition-colors">
                {crumb.name}
              </a>
            </li>
            {index < breadcrumbs.length - 1 && (
              <li class="text-neutral-600">/</li>
            )}
          </>
        ))}
        <li class="text-neutral-600">/</li>
        <li class="text-orange-400 font-medium">{title}</li>
      </ol>
    </nav>

    <!-- Title & Description -->
    <div class="max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold text-white">
        {title}
      </h1>
      {description && (
        <p class="mt-4 text-lg text-neutral-300 leading-relaxed">
          {description}
        </p>
      )}
      {productCount !== undefined && (
        <p class="mt-4 text-sm text-neutral-400">
          {productCount} {productCount === 1 ? 'producto disponible' : 'productos disponibles'}
        </p>
      )}
    </div>
  </div>
</section>
