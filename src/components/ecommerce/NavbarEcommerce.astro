---
import { Image } from "astro:assets";
import heroImage from "@images/hero-image.png";
import equipmentCategories from "@data/es/equipment-categories.json";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const categories = equipmentCategories.categories;

const navLinks = [
  {
    name: "ARRIENDA EQUIPOS",
    hasDropdown: true,
    items: categories.map(cat => ({
      name: cat.name,
      url: `/es/collections/${cat.slug}`
    }))
  },
  {
    name: "COMPRA EQUIPOS",
    hasDropdown: true,
    items: categories.slice(0, 4).map(cat => ({
      name: cat.name,
      url: `/es/buy/${cat.slug}`
    }))
  },
  {
    name: "REPUESTOS",
    url: "/es/parts"
  },
  {
    name: "SERVICIOS",
    url: "/es/services"
  },
  {
    name: "UBICACIONES",
    url: "/es/locations"
  },
  {
    name: "EMPRESA",
    hasDropdown: true,
    items: [
      { name: "Sobre Nosotros", url: "/es/about" },
      { name: "Nuestro Equipo", url: "/es/team" },
      { name: "Carreras", url: "/es/careers" }
    ]
  },
  {
    name: "CONTACTO",
    url: "/es/contact"
  }
];
---

<header class={`w-full z-50 ${transparent ? 'absolute top-0' : 'relative'}`}>
  <nav class="bg-white/95 backdrop-blur-md shadow-sm">
    <div class="max-w-[85rem] mx-auto px-4 lg:px-8">
      <div class="flex items-center justify-between h-20">

        <!-- Search Icon -->
        <button
          type="button"
          class="p-2 text-neutral-600 hover:text-orange-500 transition-colors lg:mr-4"
          aria-label="Buscar"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Logo -->
        <a href="/es" class="flex-shrink-0">
          <div class="h-12 w-auto">
            <Image
              src={heroImage}
              alt="ATM Rent Logo"
              class="h-full w-auto object-contain"
              loading="eager"
            />
          </div>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center space-x-1">
          {navLinks.map((link) => (
            link.hasDropdown ? (
              <div class="relative group">
                <button class="flex items-center px-3 py-2 text-sm font-semibold text-[#0a1628] hover:text-orange-500 transition-colors">
                  {link.name}
                  <svg class="ml-1 h-4 w-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <!-- Dropdown Menu -->
                <div class="absolute left-0 mt-0 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="pt-2">
                    <div class="bg-white rounded-lg shadow-xl border border-neutral-100 overflow-hidden">
                      {link.items?.map((item) => (
                        <a
                          href={item.url}
                          class="block px-4 py-3 text-sm text-neutral-700 hover:bg-orange-50 hover:text-orange-600 transition-colors border-b border-neutral-100 last:border-0"
                        >
                          {item.name}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={link.url}
                class="px-3 py-2 text-sm font-semibold text-[#0a1628] hover:text-orange-500 transition-colors"
              >
                {link.name}
              </a>
            )
          ))}
        </div>

        <!-- User Icon -->
        <button
          type="button"
          class="p-2 text-neutral-600 hover:text-orange-500 transition-colors"
          aria-label="Mi cuenta"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          class="lg:hidden p-2 text-neutral-600 hover:text-orange-500"
          id="mobile-menu-toggle"
          aria-label="Menú"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-neutral-200">
      <div class="px-4 py-4 space-y-2">
        {navLinks.map((link) => (
          link.hasDropdown ? (
            <div class="mobile-dropdown">
              <button
                class="flex items-center justify-between w-full px-3 py-3 text-sm font-semibold text-[#0a1628] hover:bg-neutral-50 rounded-lg"
                data-dropdown-toggle
              >
                {link.name}
                <svg class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mobile-dropdown-content hidden pl-4 mt-1 space-y-1">
                {link.items?.map((item) => (
                  <a
                    href={item.url}
                    class="block px-3 py-2 text-sm text-neutral-600 hover:text-orange-500 hover:bg-neutral-50 rounded-lg"
                  >
                    {item.name}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.url}
              class="block px-3 py-3 text-sm font-semibold text-[#0a1628] hover:bg-neutral-50 rounded-lg"
            >
              {link.name}
            </a>
          )
        ))}
      </div>
    </div>
  </nav>
</header>

<!-- Quote Sidebar (Fixed Right) -->
<div class="fixed right-0 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col">
  <!-- Rental Quote Button -->
  <a
    href="/es/quote"
    class="flex flex-col items-center justify-center bg-[#0a1628] text-white px-3 py-4 rounded-l-lg hover:bg-[#152238] transition-colors group"
  >
    <div class="relative">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <span class="absolute -top-2 -right-2 bg-orange-500 text-xs text-white rounded-full h-5 w-5 flex items-center justify-center font-bold" id="quote-count">0</span>
    </div>
    <span class="text-xs font-semibold mt-2 writing-vertical">Cotización</span>
  </a>

  <!-- Parts Order Button -->
  <a
    href="/es/cart"
    class="flex flex-col items-center justify-center bg-white text-[#0a1628] border-l border-y border-neutral-200 px-3 py-4 rounded-l-lg hover:bg-neutral-50 transition-colors mt-1"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <span class="text-xs font-semibold mt-2 writing-vertical">Pedido</span>
  </a>
</div>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>

<script>
  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Mobile dropdown toggles
  const dropdownToggles = document.querySelectorAll('[data-dropdown-toggle]');
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const content = toggle.nextElementSibling;
      const arrow = toggle.querySelector('svg');
      content?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });
</script>
