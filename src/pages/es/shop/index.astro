---
/**
 * ATM Rent - Página Principal del Ecommerce
 * Diseño basado en skyworksllc.com
 */
import EcommerceLayout from "@/layouts/EcommerceLayout.astro";
import HeroSlider from "@components/ecommerce/HeroSlider.astro";
import TrustSection from "@components/ecommerce/TrustSection.astro";
import CategoryGrid from "@components/ecommerce/CategoryGrid.astro";
import FeaturesStatsAlt from "@components/sections/features/FeaturesStatsAlt.astro";
import TestimonialsSectionAlt from "@components/sections/testimonials/TestimonialsSectionAlt.astro";
import FAQ from "@components/sections/FAQ.astro";
import faqs from "@data/es/faqs.json";

// Images for hero slider
import image1 from '@images/generador.jpg';
import image2 from '@images/construction-workers.avif';
import image3 from '@images/using-tools.avif';

// Categories with images
import placeholderImg from "@images/construction-image.png";

const heroSlides = [
  {
    id: 1,
    category: "EQUIPOS DE CONSTRUCCIÓN",
    title: "ARRIENDA EQUIPOS DE COMPACTACIÓN HOY",
    buttonText: "VER COMPACTACIÓN",
    buttonUrl: "/es/shop/collections/compactacion-pavimentacion",
    image: image1
  },
  {
    id: 2,
    category: "EQUIPOS DE CONSTRUCCIÓN",
    title: "GENERADORES DE ALTA POTENCIA DISPONIBLES",
    buttonText: "VER GENERADORES",
    buttonUrl: "/es/shop/collections/generadores-energia",
    image: image2
  },
  {
    id: 3,
    category: "EQUIPOS DE CONSTRUCCIÓN",
    title: "MAQUINARIA PROFESIONAL PARA TU PROYECTO",
    buttonText: "VER CATÁLOGO",
    buttonUrl: "/es/shop/collections",
    image: image3
  }
];

const categories = [
  {
    id: "compaction-paving",
    name: "COMPACTACIÓN Y PAVIMENTACIÓN",
    slug: "compactacion-pavimentacion",
    description: "Rodillos y placas vibratorias",
    image: placeholderImg
  },
  {
    id: "generators-power",
    name: "GENERADORES Y ENERGÍA",
    slug: "generadores-energia",
    description: "Grupos electrógenos",
    image: placeholderImg
  },
  {
    id: "demolition-tools",
    name: "DEMOLICIÓN Y HERRAMIENTAS",
    slug: "demolicion-herramientas",
    description: "Martillos demoledores",
    image: placeholderImg
  },
  {
    id: "earthmoving",
    name: "MOVIMIENTO DE TIERRA",
    slug: "movimiento-tierra",
    description: "Retroexcavadoras y excavadoras",
    image: placeholderImg
  },
  {
    id: "concrete-masonry",
    name: "CONCRETO Y ALBAÑILERÍA",
    slug: "concreto-albanileria",
    description: "Mezcladoras y vibradores",
    image: placeholderImg
  },
  {
    id: "air-compressors",
    name: "COMPRESORES DE AIRE",
    slug: "compresores-aire",
    description: "Compresores portátiles",
    image: placeholderImg
  },
  {
    id: "forklifts-telehandlers",
    name: "MONTACARGAS",
    slug: "montacargas",
    description: "Equipos de elevación",
    image: placeholderImg
  },
  {
    id: "scaffolding-ladders",
    name: "ANDAMIOS Y ESCALERAS",
    slug: "andamios-escaleras",
    description: "Acceso seguro en altura",
    image: placeholderImg
  }
];

const testimonials = [
  {
    content: "ATM Rent nos ha proporcionado equipos de alta calidad para nuestros proyectos de construcción. El servicio es excelente y la maquinaria siempre está en perfectas condiciones.",
    author: "Carlos Mendoza",
    role: "Gerente de Proyectos, Constructora Del Valle",
    avatarSrc: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3",
    avatarAlt: "Carlos Mendoza"
  },
  {
    content: "La disponibilidad de equipos y la rapidez en la entrega hacen de ATM Rent nuestro proveedor preferido. Sus generadores nos han salvado en más de una obra.",
    author: "María González",
    role: "Arquitecta, MG Arquitectos",
    avatarSrc: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3",
    avatarAlt: "María González"
  },
  {
    content: "Excelente relación calidad-precio. Los compactadores que arrendamos funcionaron impecablemente durante todo el proyecto. Muy recomendados.",
    author: "Pedro Soto",
    role: "Contratista Independiente",
    avatarSrc: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3",
    avatarAlt: "Pedro Soto"
  }
];
---

<EcommerceLayout
  title="ATM Rent - Arriendo de Equipos de Construcción en Chile"
  description="Arrienda maquinaria y equipos de construcción de alta calidad. Generadores, compactadores, retroexcavadoras, martillos demoledores y más. Servicio técnico especializado."
>
  <!-- Hero Slider -->
  <HeroSlider slides={heroSlides} />

  <!-- Trust Section -->
  <TrustSection
    yearsInBusiness={10}
    tagline="CONFIANZA POR MÁS DE 10 AÑOS"
    mainTitle="ATM RENT OFRECE ARRIENDO DE EQUIPOS DE CONSTRUCCIÓN, VENTA DE REPUESTOS Y SERVICIO TÉCNICO"
    features={[
      {
        icon: "rental",
        title: "Arriendo de Equipos",
        description: "Amplia flota de maquinaria y equipos de construcción disponibles para arriendo diario, semanal o mensual"
      },
      {
        icon: "parts",
        title: "Venta de Repuestos",
        description: "Repuestos originales y de alta calidad para mantener tus equipos funcionando al máximo rendimiento"
      },
      {
        icon: "service",
        title: "Servicio Técnico",
        description: "Mantenimiento preventivo y correctivo con técnicos certificados en terreno"
      }
    ]}
  />

  <!-- Category Grid -->
  <CategoryGrid
    title="ENCUENTRA EL EQUIPO ADECUADO"
    categories={categories}
  />

  <!-- Features Stats -->
  <FeaturesStatsAlt
    title="¿Por qué elegir ATM Rent?"
    subTitle="Más de 10 años entregando soluciones de maquinaria y equipos para la industria de la construcción en Chile. Nuestra experiencia garantiza el éxito de tu proyecto."
    benefits={[
      "Equipos certificados y en óptimas condiciones de funcionamiento",
      "Entrega y retiro en obra en toda la Región Metropolitana",
      "Soporte técnico 24/7 para emergencias en terreno",
      "Precios competitivos con opciones de arriendo flexibles"
    ]}
  />

  <!-- Testimonials -->
  <TestimonialsSectionAlt
    title="Lo que dicen nuestros clientes"
    testimonials={testimonials}
  />

  <!-- FAQ -->
  <FAQ title="Preguntas<br />frecuentes" faqs={faqs} />

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-[#0a1628]">
    <div class="max-w-[85rem] mx-auto px-4 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        ¿Listo para comenzar tu proyecto?
      </h2>
      <p class="text-lg text-neutral-300 mb-8 max-w-2xl mx-auto">
        Contáctanos hoy para obtener una cotización personalizada. Nuestro equipo está listo para ayudarte a encontrar el equipo perfecto.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/es/contact"
          class="inline-flex items-center justify-center bg-orange-500 text-white px-8 py-4 text-sm font-bold tracking-wider hover:bg-orange-600 transition-colors rounded-lg"
        >
          SOLICITAR COTIZACIÓN
        </a>
        <a
          href="https://api.whatsapp.com/send?phone=56961910135"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-white text-[#0a1628] px-8 py-4 text-sm font-bold tracking-wider hover:bg-neutral-100 transition-colors rounded-lg"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          CONTACTAR POR WHATSAPP
        </a>
      </div>
    </div>
  </section>
</EcommerceLayout>
